        supportedTypes="EMPTY RANGED_VALUE GOAL_PROGRESS WEIGHTED_ELEMENTS SHORT_TEXT LONG_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="GOAL_PROGRESS" />
      <BoundingBox x="100" y="70" width="125" height="310" />
      <Complication type="EMPTY">
        <PartDraw x="0" y="0" width="225" height="450">
          <Arc centerX="0" centerY="225" width="404" height="404" startAngle="130" endAngle="50" direction="COUNTER_CLOCKWISE">
            <Stroke color="#33FFFFFF" thickness="12" cap="ROUND" />
