        </PartDraw>
      </Complication>
      <Complication type="RANGED_VALUE">
        <PartDraw x="0" y="0" width="225" height="450">
          <Arc centerX="0" centerY="225" width="404" height="404" startAngle="130" endAngle="50" direction="COUNTER_CLOCKWISE">
            <Stroke color="#33FFFFFF" thickness="12" cap="ROUND" />
          </Arc>
          <Arc centerX="0" centerY="225" width="404" height="404" startAngle="130" endAngle="130" direction="COUNTER_CLOCKWISE">
            <Stroke color="#FF00E676" thickness="12" cap="ROUND" />
            <Transform target="endAngle" value="130 - 80 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / clamp([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN], 0.0001, 1000000000), 0, 1)" />
          </Arc>
        </PartDraw>
        <PartImage x="129" y="180" width="28" height="28">
