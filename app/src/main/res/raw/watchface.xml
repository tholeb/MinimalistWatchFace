              <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="GOAL_PROGRESS">
        <PartDraw x="0" y="0" width="225" height="450">
          <Arc centerX="0" centerY="225" width="404" height="404" startAngle="130" endAngle="50" direction="COUNTER_CLOCKWISE">
            <Stroke color="#33FFFFFF" thickness="12" cap="ROUND" />
          </Arc>
          <Arc centerX="0" centerY="225" width="404" height="404" startAngle="130" endAngle="130" direction="COUNTER_CLOCKWISE">
            <Stroke color="#FF29B6F6" thickness="12" cap="ROUND" />
            <Transform target="endAngle" value="130 - 80 * clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / clamp([COMPLICATION.GOAL_PROGRESS_TARGET_VALUE], 0.0001, 1000000000), 0, 1)" />
          </Arc>
        </PartDraw>
        <PartImage x="129" y="180" width="28" height="28">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="103" y="208" width="80" height="28">
          <Text align="CENTER" ellipsis="TRUE">
